{
  "name": "@gayoungkoh/reusable-widget",
  "version": "1.0.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://gayoungkoh.github.io/reusable-widget",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:web && pnpm run build:lib",
    "build:web": "tsc -b && vite build",
    "build:lib": "tsc -b && vite build --config vite.config.lib.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "pnpm run build:web",
    "deploy": "gh-pages -d dist/web"
  },
  "dependencies": {
    "@r2wc/react-to-web-component": "^2.0.4",
    "@tanstack/react-query": "^5.74.3",
    "@tanstack/react-query-devtools": "^5.74.3",
    "@types/node": "^22.14.1",
    "highcharts": "^12.2.0",
    "highcharts-react-official": "^3.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.3"
  }
}
